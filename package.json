{
  "name": "@fiverr/i18n",
  "version": "2.0.0",
  "description": "Translation helper",
  "keywords": [
    "i18n",
    "translation",
    "💬"
  ],
  "author": "Fiverr dev team",
  "license": "MIT",
  "homepage": "https://github.com/fiverr/i18n.js#readme",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiverr/i18n.js.git"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "browser": {
        "import": "./index.js",
        "require": "./index.cjs"
      },
      "node": {
        "import": "./index.js",
        "require": "./index.cjs"
      },
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir . --sourcemap",
    "test": "node --test tests/*.ts",
    "format": "prettier --write '**/*.{ts,js,json,md}'",
    "lint": "prettier --check '**/*.{ts,js,json,md}'"
  },
  "dependencies": {
    "@recursive/assign": "^3.0.1",
    "paraphrase": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
